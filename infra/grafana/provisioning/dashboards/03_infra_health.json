{
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum by (route) (rate(omnibrand_http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Latency p50 / p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(omnibrand_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(omnibrand_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "redis_connected_clients",
          "legendFormat": "connected clients"
        },
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "redis_blocked_clients",
          "legendFormat": "blocked clients"
        }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum by (datname) (pg_stat_activity_count{datname=~\"omnibrand.*\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "rate(omnibrand_http_requests_total{status_code=~\"5..\"}[5m]) / (rate(omnibrand_http_requests_total[5m]) + 0.001)",
          "legendFormat": "5xx error rate"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["omnibrand", "infra"],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Infrastructure Health",
  "uid": "omnibrand-infra",
  "version": 1
}
