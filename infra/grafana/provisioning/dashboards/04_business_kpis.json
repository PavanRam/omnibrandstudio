{
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Total Campaigns Processed (all time)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "fixed", "fixedColor": "green"},
          "thresholds": {"steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum(omnibrand_campaigns_completed_total{status=\"completed\"}) or vector(0)",
          "legendFormat": "completed"
        }
      ]
    },
    {
      "id": 2,
      "title": "Campaigns Failed (all time)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "fixed", "fixedColor": "red"},
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum(omnibrand_campaigns_completed_total{status=\"failed\"}) or vector(0)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total LLM Cost USD",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum(omnibrand_llm_cost_usd_total) or vector(0)",
          "legendFormat": "total cost"
        }
      ]
    },
    {
      "id": 4,
      "title": "Current Queue Depth",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "omnibrand_queue_depth or vector(0)",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 5,
      "title": "Campaigns Completed per Hour",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "increase(omnibrand_campaigns_completed_total{status=\"completed\"}[1h])",
          "legendFormat": "completed / hr"
        },
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "increase(omnibrand_campaigns_completed_total{status=\"failed\"}[1h])",
          "legendFormat": "failed / hr"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cumulative LLM Cost Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "omnibrand-prometheus"},
          "expr": "sum(omnibrand_llm_cost_usd_total)",
          "legendFormat": "cumulative cost"
        }
      ]
    }
  ],
  "refresh": "60s",
  "schemaVersion": 38,
  "tags": ["omnibrand", "business"],
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Business KPIs",
  "uid": "omnibrand-kpis",
  "version": 1
}
