# ----------------------------------------------------------------------------
# OmniBrand Studio environment configuration (local development)
# ----------------------------------------------------------------------------

# App
APP_ENV=development
LOG_LEVEL=DEBUG
#SECRET_KEY=changeme_app_secret_32chars_min
LOCAL_DEV_MODE=0
ENABLE_LOCAL_EVAL=0
ENABLE_CONVERSATION_PLANNER=1
ENABLE_STREAMING_RESPONDER=1
PORT=8000

# Database
POSTGRES_PASSWORD${POSTGRES_PASSWORD}
POSTGRES_PASSWORD_ENCODED=${POSTGRES_PASSWORD_ENCODED}
POSTGRES_DSN=postgresql+asyncpg://omnibrand:${POSTGRES_PASSWORD_ENCODED}@localhost:5432/omnibrand
# Separate DSN used by Alembic when privilege/audit DDL requires elevated creds.
ALEMBIC_DSN=postgresql+asyncpg://omnibrand:${POSTGRES_PASSWORD_ENCODED}@localhost:5432/omnibrand

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO/S3)
MINIO_PASSWORD=changeme_local_32chars
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=omnibrand
AWS_SECRET_ACCESS_KEY=changeme_local_32chars
S3_BUCKET=brand-assets

# Vector store
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_PATH=./data/chroma
BM25_CACHE_PATH=./data/bm25_cache
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=omnibrand-guides
HYBRID_FETCH_K=20
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MMR_LAMBDA=0.7

# RAG ingestion and optional MCP bridge
RAG_MAX_UPLOAD_BYTES=5242880
RAG_MCP_ENABLED=0
RAG_MCP_HOST=0.0.0.0
RAG_MCP_PORT=8001

# LLM router and provider keys
LITELLM_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPL_API_KEY=xxxx

# Langfuse
#LANGFUSE_HOST=http://localhost:3001
LANGFUSE_SECRET=changeme_secret_must_be_32chars_min
LANGFUSE_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse headless initialization (auto-provisioned on `make up`).
# The project keys reuse LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY above.
# Use LANGFUSE_INIT_USER_EMAIL / _PASSWORD to log in at http://localhost:3001.
# Do NOT wrap these values in quotes.
LANGFUSE_INIT_ORG_ID=omnibrand
LANGFUSE_INIT_ORG_NAME=OmniBrand
LANGFUSE_INIT_PROJECT_ID=omnibrand-studio
LANGFUSE_INIT_PROJECT_NAME=OmniBrand Studio
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=OmniBrand!123

# Observability
OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PROMETHEUS_METRICS_PORT=9091
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
JAEGER_URL=http://localhost:16686
JAEGER_SPAN_STORAGE_TYPE=memory
API_BASE_URL=http://localhost:8000
GRAFANA_ADMIN_PASSWORD=

# Auth / JWT
# Generate keys with: make certs
JWT_PRIVATE_KEY_PATH=./certs/private_key.pem
JWT_PUBLIC_KEY_PATH=./certs/public_key.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Runtime controls
MAX_CONCURRENT_CAMPAIGNS=5
CAMPAIGN_TIMEOUT_SECONDS=300

# LLM cost tier: "free" (Groq cross-family panel, no paid spend) or "paid"
# (pinned Claude/GPT-4o/Groq panel + premium generation).
LLM_COST_TIER=free
# Per-role overrides — uncomment to pin one agent's model independent of
# LLM_COST_TIER, without touching resolve_model_aliases().
#GENERATION_MODEL_ALIAS=
#PERSONALIZATION_MODEL_ALIAS=
#TRANSLATION_MODEL_ALIAS=
#TRANSLATION_VALIDATOR_MODEL_ALIAS=
#BRAND_TRUTHFULNESS_MODEL_ALIAS=
#JUDGE_1_MODEL_ALIAS=
#JUDGE_2_MODEL_ALIAS=
#JUDGE_3_MODEL_ALIAS=
#UTIL_FAST_MODEL_ALIAS=
#EVAL_MODEL_ALIAS=
#CHAT_UTILITY_MODEL_ALIAS=
#CHAT_BRIEF_COLLECTOR_MODEL_ALIAS=
#CHAT_UNDERSTANDING_MODEL_ALIAS=
#CHAT_RESPONDER_MODEL_ALIAS=

#HF
HF_TOKEN=

# Gemini fallback (used by LiteLLM aliases util-fast-gemini, brief-collector-gemini, responder-chat-gemini)
GOOGLE_API_KEY=
# Primary key used by LiteLLM config.
GEMINI_API_KEY=

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
AIRTABLE_SYNC_API_KEY=