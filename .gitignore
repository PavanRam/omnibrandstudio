# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Python cache
__pycache__/
*.py[cod]

# Local environment files
.env
.env.*

# Local-only Docker Compose overrides (e.g. port remaps for machine-specific conflicts)
docker-compose.override.yml

# Local vector DB/runtime artifacts
data/chroma/
backend/data/chroma/

# Local NLP download cache
backend/.nltk_data/
.nltk_data/
backend/data/bm25_cache/

# Claude Code session config (local, not repo policy)
.claude/

# JWT signing keypair — private_key.pem is a real secret, never commit
certs/

# Scratch/throwaway debug scripts
scratch/
