# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/
# Environment
.env
*.env

# Virtual environment
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# ChromaDB & vector store (large, rebuilt by running ingestion)
knowledge_base/chroma/
knowledge_base/bm25_cache/

# Logs
app.log
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/

# Raw datasets (too large for git; added manually from Kaggle)
datasets/raw/

# Streamlit cache
.streamlit/cache/

# legacy project
oldproject/

# test
test_*.py
